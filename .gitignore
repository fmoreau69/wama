# Folders
.claude/*
!.claude/skills/
# Politique de permissions + hooks = configuration VERSIONNEE (partage entre machines
# et instances). Le brouillon .claude/settings.local.json reste ignore : il est jetable
# et regenere par scripts/clean_permissions.ps1.
!.claude/settings.json
!.claude/hooks/
media/
# Médias écrits par la suite de tests (cf. wama/common/runners.py).
# ⚠ Pas de commentaire en FIN de ligne dans un .gitignore : le `#` ferait partie du motif.
media_tests/
# Fichiers de test extraits de media/ le 2026-08-25, en attente de purge.
media_tests_quarantaine/
logs/
wama-analysis/results
wama-analysis/ui_screenshots
**/migrations/0*.py

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.idea/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv — le filet couvre AUSSI les copies (.env.avant-reordre, .env.bak…) : une copie de
# secrets non ignorée a failli être commitable le 19/08. L'example, lui, est VERSIONNÉ.
.env
.env.*
!.env.example

# virtualenv
venv/
venv_win/
venv_linux/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

NUL
tmpclaude-*-cwd
.DS_Store
*.sqlite3
*.rdb

# Cloned third-party repos embedded in the project
wama/avatarizer/musetalk/
# Screenshots de travail (comparaison avant/après) — ne pas committer
claude/
# Artefact auto-généré par headroom (proxy de compression)
recommendations.toml

# Sauvegardes de base (management command backup_db)
backups/
*.dump

# Binaires des outils de sécurité (provisionnés par scripts/fetch_security_tools.py)
tools/security/bin/
wama/sandbox_apps.json
wama/*_[0-9][0-9]/
staticfiles/*_[0-9][0-9]/

# Avatars GLB (TalkingHead) — TELECHARGES par tools/update_vendors.sh, jamais commites :
# 4,7 Mo de binaire par fichier, et git ne compresse pas un GLB (chaque revision repeserait
# autant dans l historique). Meme parti que MuseTalk, cloné par setup_avatarizer.sh.
wama/static/vendors/avatars/
staticfiles/vendors/avatars/
