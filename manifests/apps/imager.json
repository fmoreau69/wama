      "descriptions": {
        "add_to_imager": {
          "args": {
            "guidance_scale": "range — À quel point suivre le prompt. [1–20] (défaut : 7.5)",
            "height": "int (défaut : 512)",
            "image_strength": "range — Influence de l'image de référence (img2img / style). 0=ignorer, 1=copier. [0–1] (défaut : 0.75)",
            "model": "select — Modèle de génération (Auto = tirage VRAM-aware au lancement). (défaut : 'stable-diffusion-v1-5')",
            "negative_prompt": "textarea — Ce qu'il faut éviter dans l'image.",
            "num_images": "select — Nombre d'images à générer en une passe. (choix : 1 | 2 | 3 | 4) (défaut : 1)",
            "output_format": "select — Format de sortie (choix : original | mp4 | webm | avi | mov | mkv | gif | mp3 …)",
            "output_quality": "select — Qualité (choix : web | balanced | max)",
            "prompt": "str (requis)",
            "seed": "number — Graine aléatoire (vide = aléatoire).",
            "steps": "range — Nombre d'étapes de diffusion. [1–100] (défaut : 30)",
            "upscale": "toggle — Agrandit l'image générée (×2). (défaut : False)",
            "width": "int (défaut : 512)"
          },
          "description": "Ajoute un élément à la file d'attente de Imager (Génération d'images et vidéos par IA (Stable Diffusion, Hunyuan, Mochi…)) et renvoie son item_id."
        },
