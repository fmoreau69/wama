    "tool_api": {
      "add": "add_to_reader",
      "descriptions": {
        "add_to_reader": {
          "args": {
            "backend": "select — Moteur OCR (choix : auto | olmocr | doctr | glm-ocr) (défaut : ReadingItem.Backend.AUTO)",
            "file_path": "str (requis)",
            "language": "text — Optionnel (ex. fr, en). Auto-détection si vide.",
            "mode": "select — Mode de lecture (choix : auto | printed | handwritten) (défaut : ReadingItem.Mode.AUTO)",
            "output_format": "select — Format du texte produit. Les autres formats restent téléchargeables ensuite. (choix : txt | markdown) (défaut : ReadingItem.OutputFormat.TXT)"
          },
          "description": "Ajoute un élément à la file d'attente de Reader (OCR) (Extraction de texte par OCR (Tesseract, PaddleOCR, EasyOCR)) et renvoie son item_id."
        },
        "get_reader_status": {
          "args": {},
          "description": "État des travaux Reader (OCR) de l'utilisateur : statut, progression, résultat."
        },
        "start_reader": {
          "args": {
            "item_id": "int"
          },
          "description": "Lance le traitement Reader (OCR) : l'item indiqué, ou tous ceux en attente si aucun id."
        }
      },
      "start": "start_reader",
      "status": "get_reader_status"
    }
