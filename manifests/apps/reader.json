    "tool_api": {
      "add": "add_to_reader",
      "descriptions": {
        "add_to_reader": {
          "args": {
            "backend": "select — Moteur OCR (défaut : 'auto')",
            "file_path": "str (requis)",
            "format_markdown": "toggle — Titres, listes et tableaux remis en Markdown par un LLM, sans rien retrancher. Le texte natif d'un PDF reste tel quel. (défaut : True)",
            "generate_analysis": "toggle — Analyse LLM du texte lu (résumé, points clés) (défaut : False)",
            "language": "text — Optionnel (ex. fr, en). Auto-détection si vide.",
            "llm_model": "select — Clé de catalogue du modèle de langage, ou « auto ». (défaut : 'auto')",
            "mode": "select — Mode de lecture (choix : auto | printed | handwritten) (défaut : 'auto')",
            "output_format": "select — Format du texte produit. Les autres formats restent téléchargeables ensuite. (choix : txt | markdown) (défaut : 'txt')",
            "quality_intent": "intent — Guide le choix automatique : à gauche un modèle léger et rapide, à droite le meilleur modèle même s'il faut attendre des ressources. [0–100] (défaut : 50)"
          },
          "description": "Ajoute un élément à la file d'attente de Reader (OCR) (Extraction de texte par OCR (Tesseract, PaddleOCR, EasyOCR)) et renvoie son item_id."
        },
        "get_reader_status": {
          "args": {},
          "description": "État des travaux Reader (OCR) de l'utilisateur : statut, progression, résultat — et, pour un travail qui attend, sa place dans la file GPU (`queue` : tâches devant, début prévu, ce qui passe avant). RUNNING à 0 % avec `queue` = en file, pas bloqué."
        },
        "start_reader": {
          "args": {
            "item_id": "int",
            "process": "str"
          },
          "description": "Lance le traitement Reader (OCR) : l'item indiqué, ou tous ceux en attente si aucun id. Avec `process` et l'id : UNE étape de l'item, comme son ▶ d'étape — les étapes d'amont encore à jour sont reprises, pas rejouées."
        }
      },
      "start": "start_reader",
      "status": "get_reader_status",
      "triad_spec": {
        "empty_msg": "Aucun document en attente.",
        "id_kwarg": "item_id",
        "model": "wama.reader.models.ReadingItem",
        "reset": "wama.reader.views._reset_for_relaunch",
        "status_fields": {
          "backend": "backend",
          "error_message": {
            "attr": "error_message",
            "or_none": true
          },
          "filename": "filename",
          "id": "id",
          "page_count": "page_count",
          "progress": "progress",
          "result_preview": {
            "attr": "result_text",
            "preview": 300
          },
          "status": "status",
          "used_backend": {
            "attr": "used_backend",
            "or_none": true
          }
        },
        "status_order": "-id",
        "task": "wama.reader.tasks.read_document_task"
      }
    }
