    "tool_api": {
      "add": "add_to_transcriber",
      "descriptions": {
        "add_to_transcriber": {
          "args": {
            "backend": "select — Moteur de transcription (choix : auto) (défaut : 'auto')",
            "enable_diarization": "toggle — Séparation des locuteurs (pyannote) (défaut : True)",
            "file_path": "str (requis)",
            "generate_summary": "toggle — Générer un résumé (défaut : False)",
            "hotwords": "textarea — Séparés par des virgules",
            "preprocess_audio": "toggle — Prétraitement audio (défaut : False)",
            "summary_type": "radio (choix : structured | meeting) (défaut : 'structured')",
            "verify_coherence": "toggle — Score + correction proposée côte à côte (défaut : False)"
          },
          "description": "Ajoute un élément à la file d'attente de Transcriber (Transcription audio/vidéo en texte (Whisper)) et renvoie son item_id."
        },
        "get_transcriber_status": {
          "args": {},
          "description": "État des travaux Transcriber de l'utilisateur : statut, progression, résultat."
        },
        "start_transcriber": {
          "args": {
            "transcript_id": "int"
          },
          "description": "Lance le traitement Transcriber : l'item indiqué, ou tous ceux en attente si aucun id."
        }
      },
      "start": "start_transcriber",
      "status": "get_transcriber_status"
    }
