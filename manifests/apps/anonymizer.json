    "tool_api": {
      "add": "add_to_anonymizer",
      "descriptions": {
        "add_to_anonymizer": {
          "args": {
            "blur_ratio": "range — Intensité du flou [1–100] (défaut : 25)",
            "classes": "list",
            "detection_threshold": "range — Seuil de détection [0–1] (défaut : 0.25)",
            "file_path": "str (requis)",
            "interpolate_detections": "toggle — Interpoler les détections manquantes (défaut : True)",
            "max_interpolation_frames": "number — Frames max à interpoler [1–60] (défaut : 15)",
            "model_to_use": "select — Modèle de détection YOLO (vide = auto selon la précision).",
            "output_format": "select — Format de sortie (défaut : 'original')",
            "output_quality": "select — Qualité de sortie (défaut : 'balanced')",
            "precision_level": "range — 0=Rapide · 50=Équilibré · 100=Précis (lent). [0–100] (défaut : 50)",
            "progressive_blur": "range — Flou progressif [0–100] (défaut : 25)",
            "roi_enlargement": "range — Agrandissement de la zone [1.0–2.0] (défaut : 1.05)",
            "rounded_edges": "number — Bords arrondis [0–50] (défaut : 5)",
            "sam3_prompt": "textarea — Ex. « blur all faces and license plates ».",
            "show_boxes": "toggle — Afficher les boîtes (défaut : True)",
            "show_conf": "toggle — Afficher la confiance (défaut : True)",
