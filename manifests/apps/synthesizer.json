        "batch": {
          "link_batch_field": "batch",
          "link_batch_related": "items",
          "link_item_field": "synthesis",
          "link_item_related": "batch_item",
          "link_name": "BatchSynthesisItem",
          "name": "BatchSynthesis",
          "user_related_name": "batch_syntheses",
          "verbose_name": "Batch de synthèses",
          "verbose_name_plural": "Batchs de synthèses"
        },
        "item": {
          "input_field": "text_file",
          "name": "VoiceSynthesis",
          "ordering": [
            "-created_at"
          ],
          "params_fields": [
            "tts_model",
            "language",
            "voice_preset",
            "speed",
            "pitch",
            "output_format",
            "output_quality"
          ],
          "user_related_name": "voice_syntheses"
        }
      },
      "processing_time": true,
      "statuses": [
        "PENDING",
        "RUNNING",
        "SUCCESS",
        "FAILURE"
      ],
      "tasks": [
        {
          "file": "workers.py",
          "function": "download_voice_refs_task",
          "lifecycle": false,
          "task_name": "wama.synthesizer.download_voice_refs"
        },
        {
          "file": "workers.py",
          "function": "synthesize_voice",
          "lifecycle": true,
          "task_name": null
        },
        {
          "file": "workers.py",
          "function": "cleanup_old_syntheses",
          "lifecycle": false,
          "task_name": null
        }
      ]
