      "runnable": true
    },
    "tool_api": {
      "add": "add_to_synthesizer",
      "descriptions": {
        "add_to_synthesizer": {
          "args": {
            "emotion_intensity": "float (défaut : 1.0)",
            "language": "select — Langue de synthèse (choix : fr | en | es | de | it | pt | pl | tr …) (défaut : 'fr')",
            "output_format": "select — Format de sortie (choix : original | mp3 | wav | flac | ogg | m4a | aac | opus)",
            "output_quality": "select — Qualité (choix : web | balanced | max)",
            "pitch": "range — Hauteur de la voix (0.5 = grave, 2.0 = aigu) [0.5–2.0] (défaut : 1.0)",
            "speed": "range — Vitesse de parole (0.5 = lent, 2.0 = rapide) [0.5–2.0] (défaut : 1.0)",
            "text": "str (requis)",
            "tts_model": "select — Modèle TTS à utiliser (choix : xtts_v2 | bark | kokoro | vits | tacotron2 | speedy_speech | higgs_audio) (défaut : 'xtts_v2')",
            "voice_preset": "select — Preset de voix (choix : default | male_1 | male_2 | female_1 | female_2 | custom | bark_v2_en_0 | bark_v2_en_1 …) (défaut : 'default')"
          },
          "description": "Ajoute un élément à la file d'attente de Synthesizer (Synthèse vocale TTS (XTTS, Higgs Audio, Kokoro…)) et renvoie son item_id."
        },
        "get_synthesizer_status": {
          "args": {},
          "description": "État des travaux Synthesizer de l'utilisateur : statut, progression, résultat."
        },
        "start_synthesizer": {
          "args": {
            "synthesis_id": "int"
          },
          "description": "Lance le traitement Synthesizer : l'item indiqué, ou tous ceux en attente si aucun id."
        }
      },
      "start": "start_synthesizer",
      "status": "get_synthesizer_status"
    }
  },
