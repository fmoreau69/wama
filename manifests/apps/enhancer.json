            "help_fallback": {
              "BSRGANx2": {
                "description": "High-quality 2x upscaler",
                "description_long": "High-quality 2x upscaler. Facteur d'agrandissement ×2, ~0.75 GB VRAM — ONNX (BSRGANx2_fp16.onnx).",
                "recommended_vram_gb": 0.75
              },
              "BSRGANx4": {
                "description": "High-quality 4x upscaler",
                "description_long": "High-quality 4x upscaler. Facteur d'agrandissement ×4, ~0.75 GB VRAM — ONNX (BSRGANx4_fp16.onnx).",
                "recommended_vram_gb": 0.75
              },
              "IRCNN_Lx1": {
                "description": "Strong denoising (no upscaling)",
                "description_long": "Strong denoising (no upscaling). Débruitage sans agrandissement (×1), ~4.0 GB VRAM — ONNX (IRCNN_Lx1_fp16.onnx).",
                "recommended_vram_gb": 4.0
              },
              "IRCNN_Mx1": {
                "description": "Medium denoising (no upscaling)",
                "description_long": "Medium denoising (no upscaling). Débruitage sans agrandissement (×1), ~4.0 GB VRAM — ONNX (IRCNN_Mx1_fp16.onnx).",
                "recommended_vram_gb": 4.0
              },
              "RealESRGANx4": {
                "description": "Highest quality 4x upscaler (slow)",
                "description_long": "Highest quality 4x upscaler (slow). Facteur d'agrandissement ×4, ~2.5 GB VRAM — ONNX (RealESRGANx4_fp16.onnx).",
                "recommended_vram_gb": 2.5
              },
              "RealESR_Animex4": {
                "description": "Fast anime-oriented 4x upscaler",
                "description_long": "Fast anime-oriented 4x upscaler. Facteur d'agrandissement ×4, ~2.5 GB VRAM — ONNX (RealESR_Animex4_fp16.onnx).",
                "recommended_vram_gb": 2.5
              },
              "RealESR_Gx4": {
                "description": "Fast general-purpose 4x upscaler",
                "description_long": "Fast general-purpose 4x upscaler. Facteur d'agrandissement ×4, ~2.5 GB VRAM — ONNX (RealESR_Gx4_fp16.onnx).",
                "recommended_vram_gb": 2.5
              }
