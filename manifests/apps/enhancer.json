      "params_attr": "MEDIA_PARAMS_JSON",
      "params_module": "wama.enhancer.params",
      "runnable": true
    },
    "tool_api": {
      "add": "add_to_enhancer",
      "descriptions": {
        "add_to_enhancer": {
          "args": {
            "ai_model": "select — Modèle AI (choix : RealESR_Gx4 | RealESR_Animex4 | BSRGANx2 | BSRGANx4 | RealESRGANx4 | IRCNN_Mx1 | IRCNN_Lx1) (défaut : 'RealESR_Gx4')",
            "blend_factor": "range — Blend [0–1] (défaut : 0.0)",
            "denoise": "toggle — Débruitage (défaut : False)",
            "file_path": "str (requis)"
          },
          "description": "Ajoute un élément à la file d'attente de Enhancer (Upscaling IA d'images/vidéos et amélioration audio (Resemble, DeepFilterNet)) et renvoie son item_id."
        },
        "get_enhancer_status": {
          "args": {},
          "description": "État des travaux Enhancer de l'utilisateur : statut, progression, résultat."
        },
        "start_enhancer": {
          "args": {
            "enhancement_id": "int"
          },
          "description": "Lance le traitement Enhancer : l'item indiqué, ou tous ceux en attente si aucun id."
        }
      },
      "start": "start_enhancer",
      "status": "get_enhancer_status"
    }
