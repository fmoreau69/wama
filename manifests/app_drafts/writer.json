{
  "body": {
    "access": {
      "min_tier": null,
      "public": false,
      "roles": []
    },
    "capabilities": {
      "accepts_url": false,
      "anti_race": true,
      "batch_type": "pipe",
      "during_preview": true,
      "has_batch": true,
      "has_url_import": false,
      "has_youtube": false,
      "inspector": true,
      "layout": true,
      "multi_format_download": null,
      "settings_modal_item": true,
      "streaming": false
    },
    "identity": {
      "category": "create",
      "color": "#3a7d5c",
      "icon": "fas fa-file-lines",
      "input_extensions": [".txt", ".md", ".html", ".htm", ".pdf", ".docx"],
      "url_name": "writer:index",
      "verbose_name": "Writer"
    },
    "inspector": {
      "detail_registered": true,
      "detail_spec": {
        "extra": [
          {"display": true, "field": "document_kind", "label": "Type de document"},
          {"display": true, "field": "output_format", "label": "Format de sortie"},
          {"display": true, "field": "model", "label": "Modèle"}
        ],
        "result_file": "output_file",
        "source_file": "reference_document"
      },
      "preview": {
        "file_field": "output_file",
        "user_field": "user"
      },
      "preview_registered": true
    },
    "models": {
      "catalog_keys": [
        "ollama:qwen3.8:latest",
        "albert:gpt-oss-120b"
      ]
    },
    "modes": {
      "domains": [
        {
          "accepts": ["prompt", "document"],
          "icon": "fa-file-lines",
          "id": "document",
          "inputs": ["prompt", "reference_document", "reference_layout"],
          "label": "Document",
          "modes": []
        }
      ]
    },
    "params": {
      "primary": "PARAMS_JSON",
      "schemas": {
        "PARAMS_JSON": [
          {
            "chip": false,
            "contexts": ["item", "batch", "panel"],
            "default": "",
            "help": "Ce que le document doit dire et pour qui : le FOND. La mise en forme se règle à part.",
            "icon": "fa-pen",
            "label": "Consigne",
            "name": "prompt",
            "section": "settings",
            "stales": ["write"],
            "type": "textarea"
          },
          {
            "chip": true,
            "choices": [["presentation", "Présentation"], ["report", "Rapport"], ["page", "Page web"]],
            "contexts": ["item", "batch", "panel"],
            "default": "presentation",
            "help": "La nature du document : elle oriente la structure du fond (diapositives, sections, page).",
            "icon": "fa-shapes",
            "label": "Type de document",
            "name": "document_kind",
            "section": "settings",
            "stales": ["write", "layout"],
            "type": "select"
          },
          {
            "chip": true,
            "choices": [["html", "HTML"]],
            "contexts": ["item", "batch", "panel"],
            "default": "html",
            "help": "Format du rendu. HTML seul au premier jet ; les autres formats s'ajouteront ici (ROADMAP §21.5).",
            "icon": "fa-file-code",
            "label": "Format de sortie",
            "name": "output_format",
            "section": "settings",
            "stales": ["layout"],
            "type": "select"
          },
          {
            "chip": false,
            "contexts": ["item", "batch", "panel"],
            "default": "",
            "help": "La FORME demandée, en mots (« style sobre », « ce tableau sur deux colonnes ») — jamais une barre d'outils.",
            "icon": "fa-palette",
            "label": "Consigne de forme",
            "name": "style_instruction",
            "section": "settings",
            "stales": ["layout"],
            "type": "textarea"
          },
          {
            "chip": true,
            "choices": [["fr", "Français"], ["en", "English"]],
            "contexts": ["item", "batch", "panel"],
            "default": "fr",
            "icon": "fa-language",
            "label": "Langue",
            "name": "language",
            "section": "settings",
            "stales": ["write", "layout"],
            "type": "select"
          },
          {
            "chip": true,
            "contexts": ["item", "batch", "panel"],
            "default": "auto",
            "group": "modele",
            "help": "Modèle de rédaction et de mise en forme (Auto = tirage au lancement). Les modèles distants suivent le niveau de publication voulu.",
            "icon": "fa-microchip",
            "label": "Modèle",
            "name": "model",
            "options_auto": true,
            "options_cloud": true,
            "options_query": {"task": "text-generation"},
            "options_source": "catalog",
            "section": "settings",
            "stales": ["write", "layout"],
            "type": "select"
          },
          {
            "chip": false,
            "contexts": ["item", "batch", "panel"],
            "default": 50,
            "group": "modele",
            "help": "Guide le choix automatique : à gauche un modèle léger et rapide, à droite le meilleur modèle même s'il faut attendre des ressources.",
            "icon": "fa-gauge-high",
            "label": "Rapide ↔ Qualité",
            "max": 100,
            "min": 0,
            "name": "quality_intent",
            "section": "settings",
            "show_if": {"equals": "auto", "field": "model"},
            "stales": ["write", "layout"],
            "step": 1,
            "type": "intent"
          }
        ]
      }
    },
    "ports": {
      "inputs": [
        {
          "description": "La consigne écrite. C'est elle que le modèle exécute.",
          "group": "prompt",
          "id": "prompt",
          "label": "Prompt",
          "multi": false,
          "types": ["prompt"]
        },
        {
          "description": "Un document qui NOURRIT le contenu (faits, chiffres, termes) sans être recopié ni transformé.",
          "group": "reference",
          "id": "reference_document",
          "label": "Document de référence",
          "multi": false,
          "types": ["document"]
        },
        {
          "description": "Un document dont on reprend la FORME (mise en page, styles, structure) — jamais le contenu.",
          "group": "reference",
          "id": "reference_layout",
          "label": "Modèle de mise en page",
          "multi": false,
          "types": ["document"]
        }
      ],
      "outputs": [
        {"id": "out", "label": "Sortie", "types": ["document"]}
      ]
    },
    "processing": {
      "anti_race": true,
      "backend_result": {"field": "output_file", "kind": "file"},
      "batch_link_model": "WriterBatchItem",
      "endpoints": [
        "about", "batch_create", "batch_delete", "batch_download", "batch_duplicate",
        "batch_preview", "batch_start", "batch_template", "batch_update", "card_html",
        "clear_all", "consolidate", "console", "delete", "download", "download_all",
        "duplicate", "global_progress", "help", "index", "merge", "move_to_batch",
        "progress", "remove_from_batch", "reorder", "reorder_queue", "start", "start_all",
        "start_process", "stop", "update_settings", "upload"
      ],
      "extra_routes": [
        {"name": "update_settings", "pattern": "settings/<int:pk>/", "view": "views.update_settings"},
        {"name": "start_process", "pattern": "start/<int:pk>/<str:process>/", "view": "views.start_process"}
      ],
      "item_model": "WriterDocument",
      "model_spec": {
        "batch": {
          "link_batch_field": "batch",
          "link_batch_related": "items",
          "link_item_field": "document",
          "link_item_related": "batch_item",
          "link_name": "WriterBatchItem",
          "name": "WriterBatch",
          "user_related_name": "writer_batches",
          "verbose_name": "Lot de documents",
          "verbose_name_plural": "Lots de documents"
        },
        "item": {
          "input_field": "reference_document",
          "name": "WriterDocument",
          "ordering": ["-created_at"],
          "params_fields": ["prompt", "document_kind", "output_format", "style_instruction",
                            "language", "model", "quality_intent"],
          "user_related_name": "writer_documents"
        }
      },
      "processing_time": true,
      "statuses": ["PENDING", "AWAITING_RESOURCES", "RUNNING", "SUCCESS", "FAILURE"],
      "tasks": [
        {"file": "tasks.py", "function": "write_document_task", "lifecycle": true,
         "task_name": null}
      ]
    },
    "prompts": {
      "targets": [
        {
          "field": "prompt",
          "kind": "intent",
          "model_field": "model",
          "reference_field": "reference_document"
        },
        {
          "field": "style_instruction",
          "kind": "intent",
          "model_field": "model",
          "reference_field": "reference_layout",
          "reference_reading": "form"
        }
      ]
    },
    "studio": {
      "params_attr": "PARAMS_JSON",
      "params_module": "wama.writer.params",
      "runnable": true
    }
  },
  "description": "Rédige un document (présentation, rapport, page web) à partir d'une consigne et d'un document de référence : le fond est écrit par un LLM, puis mis en forme dans le format de sortie (HTML d'abord). Cas d'épreuve de la route « app de zéro » (ROADMAP §21.5, ROUTE §10.5).",
  "key": "writer",
  "manifest_kind": "app",
  "name": "Writer",
  "projects": [],
  "requires": [
    {"key": "ollama:qwen3.8:latest", "kind": "model"},
    {"key": "albert:gpt-oss-120b", "kind": "model"}
  ],
  "schema_version": "1.0",
  "source": {"ref": "ROADMAP.md §21.5", "type": "authored"},
  "visibility": "private",
  "world": "media"
}
