# ============================================================================
# WAMA — modèle de configuration d'environnement.
# Copier en `.env` (gitignoré) et remplir les valeurs. NE JAMAIS commiter `.env`.
#   cp .env.example .env
# ============================================================================

# ── API Anthropic (chat IA) — optionnel ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Django ──────────────────────────────────────────────────────────────────
# Générer : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# (ou rotation automatique : python manage.py rotate_secrets --secret-key)
DJANGO_SECRET_KEY=
# Anciennes clés (rotation sans invalider les sessions). Rempli automatiquement
# par rotate_secrets ; séparées par des espaces/virgules.
# DJANGO_SECRET_KEY_FALLBACKS=

# ── Base de données PostgreSQL ──────────────────────────────────────────────
WAMA_DB_NAME=wama_db
WAMA_DB_USER=wama_user
WAMA_DB_PASSWORD=
WAMA_DB_HOST=127.0.0.1
WAMA_DB_PORT=5432

# ── Proxy réseau (optionnel — assets vendorés, apt/pip en WSL) ───────────────
PROXY=
HTTP_PROXY=

# ── LDAP université (optionnel — défauts dans settings.py) ───────────────────
# WAMA_LDAP_URI=ldap://ldap.exemple.fr
# WAMA_LDAP_STRUCTURES_DN=ou=structures,dc=exemple,dc=fr

# ── Ollama (assistant IA local) ─────────────────────────────────────────────
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODELS_DIR=

# ── Email SMTP (notifications modération) — optionnel ───────────────────────
# HOST vide = backend console (aucun envoi réel) — cf. settings.py:396.
# WAMA_EMAIL_HOST=
# WAMA_EMAIL_PORT=587
# WAMA_EMAIL_USER=
# WAMA_EMAIL_PASSWORD=
# WAMA_EMAIL_USE_TLS=1
# WAMA_EMAIL_FROM=WAMA <no-reply@exemple.fr>
# WAMA_MODERATOR_EMAILS=

# ── wama-dev-ai (agent local) — optionnel ───────────────────────────────────
WAMA_USERNAME=
# WAMA_PASSWORD=

# ── Benchmarks tiers (étage 2 qualité — manage.py sync_benchmarks) ───────────
# Clé GRATUITE (1000 req/j) : artificialanalysis.ai/data-api → API key management
ARTIFICIAL_ANALYSIS_API_KEY=

# ── Passerelle de canaux — Discord (ROADMAP §19) ─────────────────────────────
# Lancement : python manage.py run_gateway discord --check   (valide sans se connecter)
#
# JETON DU BOT — discord.com/developers/applications → votre app → onglet Bot →
# « Reset Token ». Il ne s'affiche QU'UNE FOIS. Secret : jamais dans le dépôt, jamais
# collé dans une conversation. En cas de fuite, « Reset Token » l'invalide aussitôt.
# ⚠ Sur la même page, activer « MESSAGE CONTENT INTENT » (Privileged Gateway Intents) :
#    sans lui le bot reçoit les événements mais `message.content` arrive VIDE — panne
#    silencieuse qui ressemble à un bot qui ignore les messages.
WAMA_DISCORD_TOKEN=
#
# CANAL DÉDIÉ — id(s) de salon, séparés par des virgules. Mode développeur activé dans
# Discord, puis clic droit sur le salon → « Copier l'identifiant ».
# Un salon listé ici est LE canal de WAMA : il y répond SANS mention. Partout ailleurs la
# mention reste obligatoire, et cette liste PRIME sur la mention — sans elle, n'importe qui
# ferait parler le bot dans un salon du labo en le mentionnant.
# Vide = aucun canal dédié (le bot ne répond que sur mention, et en DM).
WAMA_DISCORD_ALLOWED_CHANNELS=

# ── Claude Code sur abonnement (outil `ask_claude_code`) — optionnel ─────────
# Jeton OAuth longue durée : `claude setup-token`. Sans lui, le CLI utilise les
# identifiants d'abonnement déjà présents sur la machine.
# ⚠ NE PAS renseigner ANTHROPIC_API_KEY en croyant activer l'abonnement : Claude Code la
#    préfère et FACTURERAIT l'API. Le service la retire explicitement de l'environnement.
# CLAUDE_CODE_OAUTH_TOKEN=
# Chemin du CLI si absent du PATH (ici : binaire Windows appelé depuis WSL2).
# WAMA_CLAUDE_CLI=/mnt/c/Users/<vous>/.local/bin/claude.exe
